#!/bin/bash

## Copyright (C) 2019 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

## Keep the command trace: it is this script's diagnostic output.
set -x
set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

## System-level setup only (runs as root). The libvirt domains and the shared
## folder are set up per user in the user's own qemu:///session by
## libvirt-dist-user-setup.service, so the VMs, images and $HOME/shared belong
## to the desktop user, not root.

## {{ Taken from qemu-system-common.postinst.
# Add the kvm group unless it's already there
if ! getent group kvm >/dev/null; then
   addgroup --quiet --system kvm || true
fi
## }} Taken from qemu-system-common.postinst.

## {{ Taken from libvirt-bin.postinst.
if ! getent group libvirt >/dev/null; then
   addgroup --system libvirt
fi
## }} Taken from libvirt-bin.postinst.

## Existence of account "user" is not guaranteed at this point.
## XXX: Or is it?
adduser user kvm >/dev/null || true
adduser user libvirt >/dev/null || true

## Shared folder: group-scoped so both "user" and "sysmaint" reach it. A single
## $HOME dir cannot be cross-account traversable, so the share is a system path
## /mnt/shared, group kvmsf, mode 3770 (setgid + sticky, NO world -- secure, not
## chmod 777). Owned by "user" (the qemu:///session user), NOT root: under 9p
## accessmode=mapped QEMU runs as "user" and records the guest's ownership/mode
## as user.virtfs.* xattrs on this dir. The kernel forbids a NON-owner from
## setting user.* xattrs on a STICKY dir, so a root-owned /mnt/shared makes the
## guest-side 'chmod 3770' fixup fail EPERM and the share loses group access --
## the export MUST be owned by the qemu user. "sysmaint" reaches it via the kvmsf
## group; setgid: new entries inherit the group.
## INHERENT mapped-session limit (documented, not a bug to "fix" by root-owning,
## which breaks the mechanism): since "user" owns the export, "user" can unlink
## "sysmaint"'s HOST files here or chmod this dir -- the GUEST-side view is
## protected by the 3770 sticky stored in the mapped xattrs.
## accessmode=mapped keeps the guest's own perms decoupled from these host
## perms. Path overridable for tests.
## SUID residual (dev-preview, accepted): the GUEST mounts carry
## nosuid,nodev,noexec (vm-config-dist mount-shared), but this host dir is a
## plain directory, not a mount, so it cannot. A setuid file placed here by one
## host account and run by another escalates; closing it needs a nosuid,nodev
## self-bind-mount unit. Not shipped -- user+sysmaint are the operator's own.
shared_dir="${LIBVIRT_DIST_SHARED_DIR:-/mnt/shared}"
if ! getent group kvmsf >/dev/null; then
   addgroup --system kvmsf
fi
adduser user kvmsf >/dev/null || true
if getent passwd sysmaint >/dev/null; then
   adduser sysmaint kvmsf >/dev/null || true
fi
mkdir --parents -- "${shared_dir}"
## user-owned so qemu:///session (running as "user") can write the mapped
## user.virtfs.* xattrs on this sticky dir; root-owned would EPERM. Fall back to
## root only when "user" is absent (no session qemu to serve anyway).
if getent passwd user >/dev/null; then
   chown user:kvmsf -- "${shared_dir}"
else
   chown root:kvmsf -- "${shared_dir}"
fi
chmod 3770 -- "${shared_dir}"
