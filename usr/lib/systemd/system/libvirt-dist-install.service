[Unit]
Description=Whonix initial libvirt settings
Documentation=https://github.com/Whonix/libvirt-dist

## No run-once guard: ExecStart is idempotent and re-asserts the kvm/libvirt/
## kvmsf group membership and the /mnt/shared owner+perms every boot, so an
## account added after first boot gets access and any perm drift self-heals.

After=libvirtd.service
After=libvirt-guests.service
After=virtlockd.socket
After=virtlogd.socket
After=virtlockd-admin.socket
After=virtlogd-admin.socket

[Service]
Type=oneshot
ExecStart=/usr/libexec/libvirt-dist/install

[Install]
WantedBy=multi-user.target
